
---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---

<Layout>
  <main class="shelf-page">

    <a href="/homepage" class="back-link">
      ← My Dashboard
    </a>

    <section class="shelf-header">
      <img
        id="shelf-cover"
        class="shelf-cover"
        alt="Shelf cover"
        hidden
      />

      <div class="shelf-info">
        <h1 id="shelf-title">Loading shelf...</h1>

        <p id="shelf-created"></p>

        <a id="add-book-button" href="#" class="add-book-button">
          + Add a Book
        </a>
      </div>
    </section>

    <section class="books-section">
      <div class="books-heading">
        <h2>My Books</h2>
        <p id="books-message">Loading books...</p>
      </div>

      <div id="books-container"></div>
    </section>

  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const shelfId = window.location.pathname
    .split('/')
    .filter(Boolean)
    .pop();

  const addBookButton =
    document.querySelector<HTMLAnchorElement>('#add-book-button');

  if (addBookButton && shelfId) {
    addBookButton.href =
      `/book-search?shelf=${encodeURIComponent(shelfId)}`;
  }

  // Load the shelf's information
  async function loadShelf(): Promise<boolean> {
    const title =
      document.querySelector<HTMLElement>('#shelf-title');

    const cover =
      document.querySelector<HTMLImageElement>('#shelf-cover');

    const created =
      document.querySelector<HTMLElement>('#shelf-created');

    if (!title || !cover || !created || !shelfId) {
      return false;
    }

    const {
      data: { user },
      error: authError
    } = await supabase.auth.getUser();

    if (authError || !user) {
      window.location.replace('/signin');
      return false;
    }

    const { data: shelf, error } = await supabase
      .from('shelves')
      .select('id, name, cover_image, created_at')
      .eq('id', shelfId)
      .eq('user_id', user.id)
      .maybeSingle();

    if (error) {
      console.error('Failed to load shelf:', error.message);
      title.textContent = 'Could not load shelf.';
      return false;
    }

    if (!shelf) {
      title.textContent = 'Shelf not found.';
      return false;
    }

    title.textContent = shelf.name;

    const allowedCovers = [
      '/shelfCovers/plaid.png',
      '/shelfCovers/flower.png'
    ];

    cover.src = allowedCovers.includes(shelf.cover_image)
      ? shelf.cover_image
      : '/shelfCovers/plaid.png';

    cover.alt = `${shelf.name} cover`;
    cover.hidden = false;

    created.textContent =
      `Created: ${new Date(shelf.created_at).toLocaleDateString()}`;

    return true;
  }

  // Load books saved to the shelf
  async function loadBooks() {
    const container =
      document.querySelector<HTMLDivElement>('#books-container');

    const message =
      document.querySelector<HTMLParagraphElement>('#books-message');

    if (!container || !message || !shelfId) return;

    const { data: books, error } = await supabase
      .from('books')
      .select('id, title, author, cover_image')
      .eq('shelf_id', shelfId)
      .order('created_at', { ascending: false });

    if (error) {
      console.error('Failed to load books:', error.message);
      message.textContent = 'Could not load books.';
      return;
    }

    container.replaceChildren();

    if (!books || books.length === 0) {
      message.textContent =
        'No books added yet. Add your first book!';
      return;
    }

    message.textContent =
      `${books.length} book${books.length === 1 ? '' : 's'} on this shelf`;

    for (const book of books) {
      const card = document.createElement('article');
      card.className = 'book-card';

      if (book.cover_image) {
        const cover = document.createElement('img');

        cover.src = book.cover_image;
        cover.alt = `Cover of ${book.title}`;
        cover.className = 'book-cover';
        cover.loading = 'lazy';

        card.appendChild(cover);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'book-placeholder';
        placeholder.textContent = '📖';
        card.appendChild(placeholder);
      }

      const title = document.createElement('h3');
      title.textContent = book.title;

      const author = document.createElement('p');
      author.textContent = book.author ?? 'Unknown author';

      card.append(title, author);
      container.appendChild(card);
    }
  }

  async function initializeShelf() {
    const shelfLoaded = await loadShelf();

    if (shelfLoaded) {
      await loadBooks();
    } else {
      const message =
        document.querySelector<HTMLElement>('#books-message');

      if (message) message.textContent = '';

      // Prevent navigating to book search for an invalid shelf
      if (addBookButton) {
        addBookButton.removeAttribute('href');
        addBookButton.setAttribute('aria-disabled', 'true');
      }
    }
  }

  initializeShelf();
</script>

<style>
  :global(body) {
    margin: 0;
    background: #ffe6c5;
  }

  .shelf-page {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    padding: 35px 5%;
    background: #ffe6c5;
    color: #602e17;
  }

  /* Back to dashboard */
  .back-link {
    display: inline-block;
    margin-bottom: 35px;
    color: #602e17;
    font-family: 'Mansalva', cursive;
    font-size: 1.2rem;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* Shelf header */
  .shelf-header {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 30px 0 45px;
    border-bottom: 3px solid #c58b5b;
  }

  .shelf-cover {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 7px 7px 0 #c58b5b;
  }

  .shelf-cover[hidden] {
    display: none;
  }

  .shelf-info {
    flex: 1;
    min-width: 0;
  }

  h1 {
    font-family: 'Emilys Candy', cursive;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    margin: 0 0 15px;
    overflow-wrap: anywhere;
  }

  #shelf-created {
    font-family: 'Mansalva', cursive;
    font-size: 1.2rem;
    margin-bottom: 25px;
  }

  /* Add Book button */
  .add-book-button {
    display: inline-block;
    background: #602e17;
    color: #ffe6c5;
    padding: 14px 28px;
    border-radius: 12px;
    font-family: 'Mansalva', cursive;
    font-size: 1.2rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .add-book-button:hover {
    background: #8b4a2c;
    transform: translateY(-3px);
  }

  .add-book-button[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Books section */
  .books-section {
    padding-top: 45px;
    padding-bottom: 70px;
  }

  .books-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 25px;
  }

  h2 {
    font-family: 'Emilys Candy', cursive;
    font-size: 2.5rem;
    font-weight: normal;
    margin: 0;
  }

  #books-message {
    font-family: 'Mansalva', cursive;
    font-size: 1.1rem;
    margin: 0;
  }

  /* Full-width book grid */
  #books-container {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(180px, 1fr)
    );
    gap: 28px;
    width: 100%;
  }

  /* Book cards created by JavaScript */
  :global(.book-card) {
    min-width: 0;
    padding: 18px;
    background: #fff8ed;
    border: 2px solid #79523b;
    border-radius: 14px;
    box-shadow: 5px 5px 0 #c58b5b;
    text-align: center;
    transition: transform 0.2s;
  }

  :global(.book-card:hover) {
    transform: translateY(-5px);
  }

  :global(.book-cover) {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: contain;
    border-radius: 6px;
  }

  :global(.book-placeholder) {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 240px;
    background: #f1d2ab;
    border-radius: 6px;
    font-size: 4rem;
  }

  :global(.book-card h3) {
    font-family: 'Emilys Candy', cursive;
    font-size: 1.2rem;
    font-weight: normal;
    color: #602e17;
    margin: 15px 0 8px;
    overflow-wrap: anywhere;
  }

  :global(.book-card p) {
    font-family: 'Mansalva', cursive;
    font-size: 1rem;
    color: #79523b;
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .shelf-page {
      padding: 30px 4%;
    }

    #books-container {
      grid-template-columns: repeat(
        auto-fill,
        minmax(150px, 1fr)
      );
      gap: 20px;
    }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .shelf-page {
      padding: 24px 18px;
    }

    .shelf-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 25px;
    }

    .shelf-cover {
      width: 150px;
      height: 150px;
    }

    h1 {
      font-size: 2.4rem;
    }

    h2 {
      font-size: 2rem;
    }

    #books-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    :global(.book-card) {
      padding: 10px;
    }

    :global(.book-cover),
    :global(.book-placeholder) {
      height: 170px;
    }
  }
</style>
