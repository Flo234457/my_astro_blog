---
import astroLogo from '../assets/logo.svg';
import background from '../assets/background.svg';
import '../styles/global.css';
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<nav class="site-nav1" aria-label="about navigation">
			<a href="/about">About</a>
		</nav>
		<section id="hero">
				<img src={astroLogo.src} width="350" height="500" alt="BookMrks Homepage" />
			<h1>
				BookMarks(Static)
			</h1>
			<h2>
				︵๑ Curate the perfect digital library ๑ ︵
			</h2>
			<div class="hero-links">
				<a class="signup-button" href="/signup">Get started ➜</a>
				<a class="signin-link" href="/signin">Already have an account? Sign in</a>
			</div>
		</section>
	</main>

	
</div>

<style>
	#background {
		position: fixed;
		background-color: #ffefda;
		top: -10;
		left: -80;
		width: fit-content;
		height: fit-content;
		z-index: -1;

	}


	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	.site-nav1 {
		position: fixed;
		top: 24px;
		right: 24px;
		display: flex;
		gap: 20px;
		z-index: 1;
	}

	.site-nav1 a {
		color: #602e17;
		font-family: 'Mansalva', cursive;
		text-decoration: none;
	}

	.site-nav1 a:hover {
		text-decoration: underline;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: left;
		padding: 16px;
	}
	#hero img {
		transform: translate(259px, -250px);
	}

	h1 {
		font-family: 'Emilys Candy', cursive;
		font-size: 60px;
		font-weight: 400;
		margin-top: 0.25em;
		transform: translate(400px, -455px);
		color: #602e17;
		line-height: 1.5;


	}

	

	

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	h2 {
		font-family: 'Mansalva', cursive;
		background-color: rgb(213 161 109 / 35%);
		border-radius: 10px;
		padding: 0 0.1em;
		margin: 0 0 1em;
		font-weight: normal;
		color: #602e17;
		font-size: 20px;
		transform: translate(450px, -500px);
		align: center;

	}

	.hero-links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		transform: translate(450px, -500px);
		color: #602e17;
	}


	.signup-button {
		display: inline-block;
		padding: 0.6em 1em;
		border-radius: 6px;
		background-color: #602e17;
		color: #ffefda;
		font-family: 'Mansalva', cursive;
		text-decoration: none;
	}

	.home-button:hover {
		background-color: #c58e58;
	}

	.signin-link {
		color: #602e17;
		font-family: 'Mansalva', cursive;
	}


		#hero {
			display: block;
			padding-top: 10%;
		}

		#links {
			flex-wrap: wrap;
		}



		
</style>
